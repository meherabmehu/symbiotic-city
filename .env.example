# ---------------------------------------------------------------------------
# SYMBIOTIC CITY — example environment configuration (no real secrets here)
# Copy to .env and adjust values for your machine.
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
# SQLite is the zero-setup default. For Postgres use:
#   DATABASE_URL=postgresql+psycopg2://symbiotic:symbiotic@localhost:5432/symbiotic_city
#
# This path is relative to the *repository root*, not to the directory you run
# from, so it is the same file as the built-in default. Changing it here moves
# the database: an existing backend/data/symbiotic_city.db would be left behind
# and a fresh, empty one created at the new location.
DATABASE_URL=sqlite:///backend/data/symbiotic_city.db

# AES-grade random secret; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# Session lifetime (minutes) and cookie flags
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment: development | production
ENVIRONMENT=development
# Seed synthetic demo data on first boot (1 = yes)
SEED_DEMO_DATA=1

# Rate limiting (requests per minute per IP for auth endpoints)
AUTH_RATE_LIMIT_PER_MINUTE=30

# --- Groq AI (backend only) ---------------------------------------------------
# Server-side key for the five AI features (City Copilot, incident explanations,
# recovery advisor, what-if extraction, resilience reports). Leave empty to run
# every feature on its clearly-labelled rule-based fallback instead.
# Rules this repo enforces (see backend/tests/test_ai_provider.py):
#   * the key is read ONLY by backend settings -- never prefix it NEXT_PUBLIC_,
#     the browser must not be able to see it;
#   * never commit a real key (.env is gitignored; this example holds no value);
#   * one key only -- rate limits are respected, not routed around.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Frontend ----------------------------------------------------------------
# Where the Next.js server should proxy /api requests
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=SYMBIOTIC CITY
# One-click demo sign-in buttons on the login page. Set to 0 for a public
# deployment where the seeded accounts should not be advertised. The seeded
# users still exist either way.
NEXT_PUBLIC_DEMO_LOGIN=1
