#  Next.js frontend image.
#
#  The build context is the repository root (see docker-compose.yml), so every
#  source path is prefixed with frontend/. The previous version copied
#  frontend/ into /app and then copied /app/package.json from the build stage,
#  which only existed one directory deeper, so the image layout was wrong.
#
#  BACKEND_URL is read by next.config.mjs when rewrites are evaluated, i.e. at
#  build time, so it is passed as a build argument as well as a runtime variable.
FROM node:22-alpine AS deps
WORKDIR /app
# The image must ship npm 11. node:20-alpine bundles npm 10, which crashes resolving
# vitest's optional browser-mode peers ("Cannot read properties of null (reading
# 'edgesOut')") and aborts the install before writing anything. The project's
# preinstall guard refuses to run under npm 10 for the same reason, so this image and
# the guard have to agree. Pinned explicitly rather than relying on what a tag happens
# to bundle, so a tag update cannot silently reintroduce npm 10.
RUN npm install -g npm@11 && npm --version
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG BACKEND_URL=http://api:8000
ENV BACKEND_URL=${BACKEND_URL}
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
RUN npm run build

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

RUN addgroup -g 10001 -S appgroup && adduser -u 10001 -S appuser -G appgroup

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public

USER appuser
EXPOSE 3000
CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
